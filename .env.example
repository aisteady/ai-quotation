# ========== AI 询报价（本应用）==========
# 复制为 .env 后填写。勿将含真实密钥的 .env 提交到 Git。

PROJECT_ID=
# 中台项目 service_token → 仅用于直连 REST（API_BEARER_TOKEN 可填同一值）
SERVICE_TOKEN=
# MCP 网关 Bearer：必须与中台 MCP_CLIENT_TOKEN 一致（不要填项目 JWT）
MCP_CLIENT_TOKEN=
MCP_TRANSPORT=http
MCP_URL=http://127.0.0.1:8765/mcp
MCP_TIMEOUT=120

API_BASE_URL=http://127.0.0.1:8000
API_BEARER_TOKEN=

# 大模型经中台 MCP chat_completion；密钥配在中台 DASHSCOPE_API_KEY
# 留空 LLM_MODEL → 使用中台「大模型管理」中的项目型号
# LLM_MODEL=qwen-max
TOP_K=5
SEARCH_THRESHOLD=0.45

# 信息补全 loop 最大轮数
MAX_CLARIFY_LOOPS=5
# 线上 harness loop：扫描待人审间隔（秒）；0=关闭
HARNESS_LOOP_INTERVAL_SEC=60
# 配置经验召回阈值（0~1，越低越容易套用）
EXPERIENCE_APPLY_THRESHOLD=0.35

# 与中台项目 Schema 一致
APP_DB_SCHEMA=ai_inquiry_quotation
# DATABASE_URL=postgresql://user:pass@localhost:5432/aibase
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=
# DB_NAME=aibase

PORT=8504
ENVIRONMENT=development

# ---- 对智能客服开放的同步推荐 API ----
CUSTOMER_API_HOST=0.0.0.0
CUSTOMER_API_PORT=8510
# 生产建议配置；空则开发可不鉴权
# CUSTOMER_API_TOKEN=
